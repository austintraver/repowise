{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$CLAUDE_PROJECT_DIR/.claude/hooks/use_graphify_profile.py\" --target claude",
            "timeout": 5,
            "statusMessage": "Checking Graphify model profile"
          }
        ]
      }
    ]
  }
}
